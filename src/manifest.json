{
  "manifest_version": 3,
  "name": "Zoho Desk Comment Tracker",
  "version": "1.0.0",
  "description": "Automatically captures Zoho Desk ticket comments and saves them as organized daily text files with hierarchical folders, tagging, and category reports.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://desk.zoho.in/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://desk.zoho.in/*"],
      "js": ["src/injected/index.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://desk.zoho.in/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  }
}
